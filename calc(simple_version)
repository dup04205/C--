/*
 * 연습 1: 계산기 만들기 => 두 수를 입력받아 사칙연산 결과를 출력
 * 학습 요소: 기본 자료형(double), scanf/printf, switch문
 * 핵심: 0으로 나누기 예외처리, 연산자 입력 시 공백 처리
 * 확장: 계산기에 제곱근, 제곱 기능 등 추가
 */

#include <stdio.h>
#include <math.h>

int main(void)
{
    double num1, num2 = 0, result;
    char op;

    printf("=== 계산기 ===\n");
    printf("수식 입력 (예: 3 + 4, 5 ^ (제곱), 9 s (제곱근)): ");

    /* 연산자 입력 시 공백 처리: %c 앞의 공백이 공백·탭·개행을 건너뛴다
       → "3+4", "3 + 4" 모두 인식 */
    if (scanf("%lf %c", &num1, &op) != 2) {
        printf("잘못된 입력입니다.\n");
        return 1;
    }

    /* 사칙연산일 때만 두 번째 숫자를 읽는다 */
    if (op == '+' || op == '-' || op == '*' || op == '/') {
        if (scanf("%lf", &num2) != 1) {
            printf("잘못된 입력입니다.\n");
            return 1;
        }
    }

    switch (op) {
        case '+':
            result = num1 + num2;
            printf("결과: %g + %g = %g\n", num1, num2, result);
            break;
        case '-':
            result = num1 - num2;
            printf("결과: %g - %g = %g\n", num1, num2, result);
            break;
        case '*':
            result = num1 * num2;
            printf("결과: %g * %g = %g\n", num1, num2, result);
            break;
        case '/':
            /* 0으로 나누기 예외처리 */
            if (num2 == 0) {
                printf("오류: 0으로 나눌 수 없습니다.\n");
                return 1;
            }
            result = num1 / num2;
            printf("결과: %g / %g = %g\n", num1, num2, result);
            break;
        case '^':   /* 확장: 제곱 */
            result = num1 * num1;
            printf("결과: %g^2 = %g\n", num1, result);
            break;
        case 's':   /* 확장: 제곱근 */
            if (num1 < 0) {
                printf("오류: 음수는 제곱근을 계산할 수 없습니다.\n");
                return 1;
            }
            result = sqrt(num1);
            printf("결과: sqrt(%g) = %g\n", num1, result);
            break;
        default:
            printf("지원하지 않는 연산자 (+, -, *, /, ^(제곱), s(제곱근) 만 가능)\n");
            return 1;
    }

    return 0;
}
